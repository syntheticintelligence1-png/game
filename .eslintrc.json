{ "root": true, "env": { "browser": true, "es2022": true }, "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
  "rules": { "no-undef": "error", "no-unused-vars": ["warn", { "args": "none", "varsIgnorePattern": "^_" }], "no-dupe-keys": "error", "no-dupe-class-members": "error", "no-unreachable": "warn", "no-self-assign": "error", "no-const-assign": "error", "no-redeclare": "error", "no-shadow-restricted-names": "error", "no-use-before-define": ["error", { "functions": false, "classes": false, "variables": true }], "getter-return": "error", "no-func-assign": "error", "no-import-assign": "error", "valid-typeof": "error", "no-unsafe-negation": "error", "use-isnan": "error", "no-cond-assign": "warn", "no-sparse-arrays": "error", "no-dupe-else-if": "error", "no-duplicate-case": "error" } }
